# ---------------------------------------------------------------------------
# Open Portfolio Platform — settings and API keys
#
# 1. Copy this file to a new file named .env in the same folder:
#        cp .env.example .env
# 2. Paste your keys after the = signs below. No quotes or spaces are needed.
# 3. Run:  opp keys        (shows which keys were found, masked)
#
# .env is listed in .gitignore. Never commit it, paste it into chat, or put
# keys in code, CSV files or rule files. A real environment variable with the
# same name always takes priority over this file.
# ---------------------------------------------------------------------------

# Where live prices come from. One of:
#   simulated    no key, no network (the default)
#   coinbase     live crypto prices, no key needed, open 24 hours a day
#   finnhub      live US stock and crypto trades       -> needs FINNHUB_API_KEY
#   alpaca       live US stock trades (IEX on free)     -> needs both ALPACA keys
#   alpaca-test  Alpaca's always-on FAKEPACA test feed  -> needs both ALPACA keys
#   yahoo        delayed quotes, polled; no key
OPP_DATA_PROVIDER=simulated

# The portfolio to stream: a CSV of real instruments and quantities.
# Leave empty to use the built-in sample fund (simulated feed only).
OPP_PORTFOLIO_FILE=

# --- Finnhub (free key at finnhub.io -> Dashboard) -------------------------
FINNHUB_API_KEY=

# --- Alpaca (free account at alpaca.markets -> API Keys; paper keys work) --
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Alpaca stock feed: iex (free plan) or sip (paid plan)
ALPACA_FEED=iex

# --- Optional: language model for the explainer ----------------------------
ANTHROPIC_API_KEY=

# --- Tuning (optional) ------------------------------------------------------
# Seconds without a trade before an instrument is flagged as stale
OPP_STALE_SECONDS=120
# Benchmark ticker for beta and tracking error, as Yahoo knows it (e.g. SPY, ACWI)
OPP_BENCHMARK=SPY
